NODE_ENV=development
DATABASE_URL=postgresql://livebrary:livebrary@127.0.0.1:5432/livebrary?schema=public
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_CODE_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
ADMIN_FALLBACK_CODE=Trust
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Admin second factor (Discord OAuth2 QR). Redirect: {PUBLIC_ORIGIN}/api/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Address a phone can reach. Defaults to APP_ORIGIN.
PUBLIC_ORIGIN=
DISCORD_ACTIVITY_CHANNEL_ID=
DISCORD_SECURITY_CHANNEL_ID=
DISCORD_DEVELOPER_CODE_CHANNEL_ID=
DISCORD_LOG_ENABLED=false
DISCORD_LOG_AGGREGATION_SECONDS=30
ADMIN_CODE_ROTATION_TIMEZONE=Asia/Seoul
APP_ORIGIN=http://127.0.0.1:5173
# npm start listens here. 0.0.0.0 accepts other devices on the network.
HOST=0.0.0.0
API_PORT=3001
COLLAB_PORT=1234
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
TLS_CERT_PATH=
TLS_KEY_PATH=
REDIS_URL=
FORCE_SECURE_COOKIES=false
