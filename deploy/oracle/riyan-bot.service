[Unit]
Description=Riyan Discord bot for Livebrary
After=network-online.target postgresql.service livebrary.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=riyan
Group=riyan
WorkingDirectory=/opt/riyan-bot
EnvironmentFile=/etc/riyan-bot.env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
